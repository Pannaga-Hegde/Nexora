# ==========================================
# Nexora Backend — Production Environment Configuration
# ==========================================
# Copy this file to .env for local development.
# All production secrets must be injected via Render's Environment Variables UI.
# NEVER commit real values for any SECRET/KEY/URL/PASSWORD variables.
#
# Generate secure values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==========================================

# ── Deployment Environment ───────────────────────────────────────────────────
# Values: development | production
ENVIRONMENT=development

# ── Database Connection ───────────────────────────────────────────────────────
# Local SQLite (development only):
#   DATABASE_URL=sqlite:///./nexora_dev.db
#   (MIGRATION_DATABASE_URL is not needed locally; it falls back to DATABASE_URL)
#
# Supabase PostgreSQL (production) with TRUE Least-Privilege Separation:
#   DATABASE_URL = nexora_runtime connection (DML only)
#     DATABASE_URL=postgresql://nexora_runtime:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
#   MIGRATION_DATABASE_URL = nexora_migrator connection (DDL + DML)
#     MIGRATION_DATABASE_URL=postgresql://nexora_migrator:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
DATABASE_URL=sqlite:///./nexora_dev.db
MIGRATION_DATABASE_URL=

# ── JWT Authentication Secret ─────────────────────────────────────────────────
# REQUIRED. Must be a cryptographically random 32+ byte string.
# Production: inject via Render "Environment Variables" — never commit to Git.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=nexora-development-jwt-secret-key-32bytes-min!

# ── MFA Encryption Key ────────────────────────────────────────────────────────
# REQUIRED in ENVIRONMENT=production. Must be distinct from SECRET_KEY.
# If unset in production, the application will refuse to start.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MFA_ENCRYPTION_KEY=

# ── Cookie Security ───────────────────────────────────────────────────────────
# Set to true in production (Render). Ensures cookies are only sent over HTTPS.
# Automatically inferred from ENVIRONMENT=production if not explicitly set.
COOKIE_SECURE=false

# ── CORS / Frontend Origins ───────────────────────────────────────────────────
# Comma-separated list of allowed cross-origin request origins.
# Production: https://<production-frontend-domain>
# Local Dev:  http://localhost:5173,http://127.0.0.1:5173,...
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# ── Frontend URL ─────────────────────────────────────────────────────────────
# Used to generate email invitation links. Must match the deployed frontend URL.
# Production: https://<production-frontend-domain>
FRONTEND_URL=http://localhost:5173

# ── Supabase PostgreSQL & Storage ────────────────────────────────────────────
# SUPABASE_URL: Your project's API URL from Supabase Dashboard > Settings > API
# SUPABASE_SECRET_KEY: Service role secret key (BACKEND-ONLY — never expose to frontend)
# SUPABASE_STORAGE_BUCKET: Name of the private file storage bucket
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=nexora-files

# ── SQL Query Debugging ───────────────────────────────────────────────────────
# Set to false in production to prevent SQL query leakage into logs.
SQL_ECHO=false

# ── Development Data Seeding ──────────────────────────────────────────────────
# Set to false in production. Only enable for initial local data setup.
SEED_DEV_DATA=false

# ── SMTP Email (Invitations & PDF Reports) ────────────────────────────────────
# Optional. Required only for email invitations and PDF report delivery.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@nexora.academic.org
