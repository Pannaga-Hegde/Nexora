# ==========================================
# Nexora Backend Environment Configuration
# ==========================================

# PostgreSQL Database Connection URL
# Production: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Local: postgresql://postgres:postgres@localhost:5432/project_manager
DATABASE_URL=

# JWT HMAC-SHA256 Secret Key (Must be a secure random 32+ byte string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Allowed CORS Origins (comma-separated, e.g., https://nexora.vercel.app,http://localhost:5173,http://127.0.0.1:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQL Query Echoing (false in production)
SQL_ECHO=false

# Supabase Storage Configuration (Persistent File Uploads)
# Note: Keep the bucket private ('nexora-files'). Only backend uses service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nexora-files

# Optional: SMTP Configuration for Email Reports and Invitations
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@nexora.academic.org

