# ==========================================
# Nexora Frontend — Vercel Environment Configuration
# ==========================================
# These are BUILD-TIME variables injected by Vercel at build.
# Set these in the Vercel Dashboard > Project > Settings > Environment Variables.
# NEVER put backend secrets, database URLs, or encryption keys in VITE_* variables.
# ==========================================

# ── API Base URL (Required for production) ────────────────────────────────────
# The full HTTPS URL of the Render backend API.
# This is the only VITE_ variable required for production.
# Example: https://nexora-api.onrender.com
# (No trailing slash)
VITE_API_URL=https://<production-api-domain>

# ── Optional Site URL ────────────────────────────────────────────────────────
# Used for Open Graph / meta tags. Defaults to window.location.origin if unset.
# Example: https://nexora.yourdomain.com
# VITE_SITE_URL=https://<production-frontend-domain>

# ──────────────────────────────────────────────────────────────────────────────
# NEVER include any of the following in frontend environment variables:
#   - DATABASE_URL
#   - SECRET_KEY
#   - MFA_ENCRYPTION_KEY
#   - SUPABASE_SECRET_KEY
#   - SMTP_PASSWORD
#   - Any backend secret or private key
# ──────────────────────────────────────────────────────────────────────────────
