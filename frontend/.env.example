# ==========================================
# Nexora Frontend Environment Configuration
# ==========================================

# Base API URL for Backend FastAPI Server
# Development: http://localhost:8000
# Production: https://your-backend-api.vercel.app (or custom backend URL)
VITE_API_URL=http://localhost:8000

# Optional: Production / Deployment Site URL (used for SEO canonical tags and Open Graph metadata)
# On Vercel, leave empty to automatically use runtime window.location.origin,
# or specify your Vercel deployment URL (e.g., https://nexora-app.vercel.app) or custom domain.
VITE_SITE_URL=

# Optional: Analytics Measurement ID (Google Analytics 4 / Tag Manager)
# Example: G-XXXXXXXXXX
VITE_ANALYTICS_ID=
